---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: "home" | "automotivo" | "ferramentas" | "areas" | "metodo" | "autor";
}

const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><defs><linearGradient id='g' x1='0' y1='1' x2='0' y2='0'><stop offset='0' stop-color='%23FFD7E6'/><stop offset='.35' stop-color='%23FF7BAE'/><stop offset='.65' stop-color='%230A2BFF'/><stop offset='1' stop-color='%23050506'/></linearGradient></defs><rect width='100' height='100' fill='url(%23g)'/><rect x='38' y='28' width='24' height='52' fill='%23050506'/><rect x='46' y='48' width='8' height='32' fill='%23FFD7E6'/></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=Big+Shoulders+Stencil+Display:wght@600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="/tema.js"></script>
  </head>
  <body>
    <!--
      THESIS: Caporici Labs sells synthesis — scattered internet noise becomes a lit stage of clarity; refuse terminal cosplay and SaaS icon-card grids.
      OWN-WORLD: Stagecraft cyclorama dawn — night→cobalt→rose→dawn wash field, film grain, stencil cue type, Public Sans reading, controls low in frame, monolith as synthesis silhouette.
      STORY: Visitor sees Victor's ability to gather confused sources and synthesize a progressive corpus, then enters Automotivo or a tool with honest limits.
      FIRST VIEWPORT: Full-bleed cyclorama dawn. Hero-level CAPORICI LABS. One synthesis headline. One lede. Two CTAs low. Dominant horizon image with monolith; no chips or stats.
      FORM: User-pinned stagecraft-theater-lighting-cyclorama-dawn (Rain Garden alternate declined); seed f0e1e513 acknowledged; mode persuade; UI/UX Exaggerated Minimalism × portfolio storytelling.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <div class="grain" aria-hidden="true"></div>
    <Header active={active} />
    <slot />
    <Footer />
  </body>
</html>
