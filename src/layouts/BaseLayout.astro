---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: "home" | "automotivo" | "ferramentas" | "areas" | "metodo" | "autor";
}

const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='8' fill='%230a0b0d'/><rect x='18' y='28' width='64' height='14' fill='%23f0b429'/><rect x='18' y='50' width='40' height='14' fill='%23f5f2ea'/><rect x='18' y='72' width='52' height='10' fill='%233dbe8c'/></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Barlow+Condensed:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="/tema.js"></script>
  </head>
  <body>
    <!--
      THESIS: Knowledge modules depart on a live board — refuse the SaaS docs hero of soft cards and purple gradients.
      OWN-WORLD: Split-flap concourse: matte black flap faces, steel frame, amber lamps, painted white condensed type, green for on-time/publicado.
      STORY: Visitor sees Caporici Labs as the station board, picks a track (domain), boards published rows; trusts sources and limits, not marketing.
      FIRST VIEWPORT: Full-bleed board. Brand CAPORICI LABS as flap wordmark. One destination headline. One short line. Two board CTAs. Live domain rows ticking under.
      FORM: Challenger signals-instruments-split-flap-concourse fused over grounded #7 schematic wall; seed f48f179b; mode persuade.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <Header active={active} />
    <slot />
    <Footer />
  </body>
</html>
