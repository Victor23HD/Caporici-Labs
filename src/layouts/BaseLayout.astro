---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: "home" | "automotivo" | "ferramentas" | "areas" | "metodo" | "autor";
}

const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='14' fill='%230b1220'/><path d='M28 70V30h10l14 28 14-28h10v40h-9V48L54 70h-8L34 48v22H28z' fill='%23e8eef7'/><rect x='28' y='76' width='44' height='4' rx='2' fill='%233b82f6'/></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Sora:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="/tema.js"></script>
  </head>
  <body>
    <!--
      THESIS: Caporici Labs is a developer docs portal — dark chrome, grid field, section cards — that sells synthesis without borrowed corporate brand costume or terminal cosplay.
      OWN-WORLD: Docs-portal swiss: near-black navbar with blue cue line, paper+grid body, Sora/Public Sans, category accent rails on interactive cards only.
      STORY: Visitor lands, understands Caporici Labs, enters Automotivo corpus, tools, or the public repo.
      FIRST VIEWPORT: Dark nav. Centered Caporici Labs title + one lede. Three interactive section cards (Docs, Ferramentas, Código). Caporici mark only.
      FORM: User-pinned developer-docs portal layout; UI/UX FAQ/Documentation Landing × Swiss Minimalism; prior theatrical worlds retired.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <Header active={active} />
    <slot />
    <Footer />
  </body>
</html>
