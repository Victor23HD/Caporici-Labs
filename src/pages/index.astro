---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  listarArtigos,
  slugDoArtigo,
  trilhasComContagem,
} from "../lib/content";

const artigos = await listarArtigos();
const publicados = artigos.filter((item) => item.data.status === "publicado");
const trilhas = trilhasComContagem(artigos);
const trilhasAtivas = trilhas.filter((t) => t.publicados > 0).length;
---

<BaseLayout
  title="Caporici Labs: documentação e ferramentas de engenharia crítica"
  description="Caporici Labs reúne conhecimento disperso sobre sistemas embarcados críticos e transforma em corpus, com fonte, limite e ferramentas no navegador."
  active="home"
>
  <main class="home portal">
    <section class="portal-hero">
      <div class="wrap hero-center">
        <h1 class="portal-title">Caporici Labs</h1>
        <p class="portal-lede">
          Documentação, síntese e ferramentas — do sinal elétrico à nuvem,
          com fonte e limite à vista.
        </p>
      </div>
    </section>

    <section class="portal-cards" aria-label="Entradas principais">
      <div class="wrap cards-grid">
        <a class="portal-card accent-docs" href="/automotivo/">
          <div class="card-face">
            <span class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H18v16H6.5A2.5 2.5 0 0 0 4 21.5z"></path>
                <path d="M4 5.5V21.5"></path>
                <path d="M8 8h7M8 12h7M8 16h4"></path>
              </svg>
            </span>
            <h2>Docs</h2>
            <p>
              Corpus automotivo em ordem: arquitetura, CAN, diagnóstico e
              software embarcado — {publicados.length} textos publicados.
            </p>
          </div>
        </a>

        <a class="portal-card accent-tools" href="/ferramentas/">
          <div class="card-face">
            <span class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M14.7 6.3a4.2 4.2 0 0 0-5.9 5.9L3 18l3 3 5.8-5.8a4.2 4.2 0 0 0 5.9-5.9l-2.2 2.2-1.8-.2-.2-1.8z"></path>
              </svg>
            </span>
            <h2>Ferramentas</h2>
            <p>
              Utilitários no navegador para validar quadros e ideias sem
              inventar significado que a ferramenta não tem.
            </p>
          </div>
        </a>

        <a
          class="portal-card accent-code"
          href="https://github.com/Victor23HD/Caporici-Labs"
          rel="noopener"
        >
          <div class="card-face">
            <span class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M9 19c-4.3 1.4-4.3-2.1-6-2.5M15 22v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.1-1.5 6.1-6.6a5 5 0 0 0-1.3-3.4 4.8 4.8 0 0 0-.1-3.5s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.8 4.8 0 0 0-.1 3.5A5 5 0 0 0 4 9.9c0 5.1 3.2 6.3 6.1 6.6a3.4 3.4 0 0 0-.9 2.6V22"></path>
              </svg>
            </span>
            <h2>Código</h2>
            <p>
              Repositório aberto do laboratório: conteúdo, ferramentas e o
              contrato editorial — clones e correções bem-vindos.
            </p>
          </div>
        </a>
      </div>
    </section>

    <div class="wrap home-body">
      <section class="secao-home" id="sintese">
        <div class="secao-cabecalho">
          <h2>Como eu sintetizo</h2>
          <p>
            O site vende a capacidade de reunir o que a internet espalha —
            normas, fóruns, PDFs e prática — e devolver um caminho legível.
          </p>
        </div>

        <ol class="sintese-passos">
          <li>
            <strong>Reúno o disperso</strong>
            <p>Norma, fabricante, kernel, fórum e linha de produção.</p>
          </li>
          <li>
            <strong>Organizo o modelo</strong>
            <p>Do fio à nuvem, na ordem em que o desenvolvedor precisa pensar.</p>
          </li>
          <li>
            <strong>Marco o limite</strong>
            <p>Fato, prática, didática e hipótese ficam separados.</p>
          </li>
        </ol>
      </section>

      <section class="secao-home" id="areas">
        <div class="secao-cabecalho">
          <h2>Áreas</h2>
          <p>
            Automotivo é o eixo aberto ({trilhasAtivas} trilha com conteúdo).
            O restante permanece pesquisa até haver corpus de verdade.
          </p>
        </div>

        <div class="area-lista" role="list">
          <a class="area-linha" href="/automotivo/" role="listitem">
            <span class="estado-pill aberto">aberto</span>
            <span class="area-titulo">Automotivo</span>
            <span class="area-texto">{publicados.length} textos · CAN, UDS, AUTOSAR</span>
          </a>
          <div class="area-linha dim" role="listitem">
            <span class="estado-pill pesquisa">pesquisa</span>
            <span class="area-titulo">Aviação</span>
            <span class="area-texto">Linha de pesquisa</span>
          </div>
          <div class="area-linha dim" role="listitem">
            <span class="estado-pill pesquisa">pesquisa</span>
            <span class="area-titulo">Ferroviário</span>
            <span class="area-texto">Linha de pesquisa</span>
          </div>
          <div class="area-linha dim" role="listitem">
            <span class="estado-pill pesquisa">pesquisa</span>
            <span class="area-titulo">Agro</span>
            <span class="area-texto">Linha de pesquisa</span>
          </div>
          <div class="area-linha dim" role="listitem">
            <span class="estado-pill pesquisa">pesquisa</span>
            <span class="area-titulo">Náutico</span>
            <span class="area-texto">Linha de pesquisa</span>
          </div>
        </div>
      </section>

      <section class="secao-autor" id="autor">
        <div class="autor-marca" aria-hidden="true">VC</div>
        <div>
          <h2>Victor Caporici</h2>
          <p class="autor-resumo">
            Engenheiro de software sênior C/C++. Este laboratório é independente:
            a síntese que eu faço ao pesquisar sistemas embarcados críticos,
            publicada com fonte e limite.
          </p>
          <div class="acoes">
            <a class="botao secundario" href="https://github.com/Victor23HD">GitHub</a>
            <a class="botao" href="/automotivo/">Abrir docs</a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
