---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  listarArtigos,
  rotuloDiataxis,
  slugDoArtigo,
  trilhasComContagem,
} from "../lib/content";

const artigos = await listarArtigos();
const publicados = artigos.filter((item) => item.data.status === "publicado");
const trilhas = trilhasComContagem(artigos);

const areas = [
  {
    codigo: "AUTO",
    titulo: "Automotivo",
    estado: "NO HORÁRIO",
    estadoClass: "on-time",
    href: "/automotivo/",
    texto: `CAN, CAN FD, LIN, J1939, UDS, AUTOSAR, Linux embarcado, gateways e telemetria. ${publicados.length} textos no corpus.`,
  },
  {
    codigo: "AIR",
    titulo: "Aviação",
    estado: "PLANEJADA",
    estadoClass: "hold",
    texto: "Avionics data buses, software determinístico, particionamento e conceitos de certificação.",
  },
  {
    codigo: "RAIL",
    titulo: "Ferroviário",
    estado: "PLANEJADA",
    estadoClass: "hold",
    texto: "Redes de bordo, controle de trens, sinalização, redundância e operação segura.",
  },
  {
    codigo: "AGRO",
    titulo: "Máquinas agrícolas",
    estado: "PLANEJADA",
    estadoClass: "hold",
    texto: "ISOBUS, integração entre implementos, controle distribuído e telemetria de campo.",
  },
  {
    codigo: "SEA",
    titulo: "Náutico",
    estado: "PLANEJADA",
    estadoClass: "hold",
    texto: "NMEA, instrumentação, integração de bordo e edge resiliente em conectividade limitada.",
  },
  {
    codigo: "CORE",
    titulo: "Fundamentos compartilhados",
    estado: "BASE",
    estadoClass: "base",
    texto: "C/C++, RTOS, Linux, concorrência, memória, protocolos, segurança e observabilidade.",
  },
];
---

<BaseLayout
  title="Caporici Labs: engenharia de sistemas embarcados, explicada de dev para dev"
  description="Caporici Labs organiza, conecta e verifica conhecimento sobre sistemas embarcados críticos: automotivo, aviação, ferroviário, agrícola e náutico, de desenvolvedor para desenvolvedor."
  active="home"
>
  <main class="home">
    <section class="board-hero" aria-label="Quadro de partidas do Caporici Labs">
      <div class="board-frame">
        <div class="board-header">
          <p class="board-station">CAPORICI LABS</p>
          <p class="board-clock" id="board-clock" aria-live="polite">--:--</p>
        </div>

        <h1 class="board-destination">
          <span class="flap-line">CONHECIMENTO DISPERSO</span>
          <span class="flap-line accent">ENGENHARIA CONECTADA</span>
        </h1>

        <p class="board-lede">
          Eu pesquiso, organizo e verifico sistemas embarcados críticos para que um
          desenvolvedor consiga ler o caminho inteiro: do sinal elétrico à nuvem,
          com fonte, limite e ferramenta à vista.
        </p>

        <div class="acoes">
          <a class="botao" href="#areas">Ver partidas</a>
          <a class="botao secundario" href="/automotivo/">Embarcar no automotivo</a>
        </div>

        <div class="board-live" aria-label="Áreas em quadro">
          <div class="board-cols" aria-hidden="true">
            <span>CÓD</span>
            <span>DESTINO</span>
            <span>STATUS</span>
          </div>
          {
            areas.slice(0, 4).map((area, i) => (
              <div class={`board-row flip-in`} style={`--i:${i}`}>
                <span class="cell code">{area.codigo}</span>
                <span class="cell dest">{area.titulo}</span>
                <span class={`cell status ${area.estadoClass}`}>{area.estado}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="secao-home" id="areas">
      <div class="secao-cabecalho">
        <h2>Partidas por área</h2>
        <p>
          Os setores mudam de nome. Os problemas se repetem: comunicação determinística,
          recurso escasso, segurança, diagnóstico, atualização e integração. Eu conecto
          essas áreas em vez de tratá-las como ilhas.
        </p>
      </div>

      <div class="board-table" role="list">
        {
          areas.map((area) =>
            area.href ? (
              <a class="board-entry" href={area.href} role="listitem">
                <span class="cell code">{area.codigo}</span>
                <span class="cell dest">
                  <strong>{area.titulo}</strong>
                  <em>{area.texto}</em>
                </span>
                <span class={`cell status ${area.estadoClass}`}>{area.estado}</span>
              </a>
            ) : (
              <div class="board-entry muted" role="listitem">
                <span class="cell code">{area.codigo}</span>
                <span class="cell dest">
                  <strong>{area.titulo}</strong>
                  <em>{area.texto}</em>
                </span>
                <span class={`cell status ${area.estadoClass}`}>{area.estado}</span>
              </div>
            ),
          )
        }
      </div>
    </section>

    <section class="secao-home">
      <div class="secao-cabecalho">
        <h2>Itinerário da informação</h2>
        <p>
          Entender um protocolo isolado não basta. Siga a informação inteira: nasce no
          sensor, disputa o barramento, atravessa o gateway, vira software e chega a
          uma ferramenta.
        </p>
      </div>

      <ol class="pilha">
        <li><span>01</span><strong>Física</strong><p>Sinal, ruído, terminação e limites do meio.</p></li>
        <li><span>02</span><strong>Rede</strong><p>Quadros, arbitragem, transporte e erro.</p></li>
        <li><span>03</span><strong>Plataforma</strong><p>MCU, RTOS, Linux, drivers e runtime.</p></li>
        <li><span>04</span><strong>Aplicação</strong><p>Controle, diagnóstico e comportamento.</p></li>
        <li><span>05</span><strong>Edge &amp; nuvem</strong><p>Gateway, telemetria, OTA e observabilidade.</p></li>
      </ol>
    </section>

    <section class="secao-home" id="metodo">
      <div class="secao-cabecalho">
        <h2>Confiança não vem de layout bonito</h2>
        <p>
          Vem de separar fato, interpretação e hipótese. Cada módulo deixa outro
          engenheiro discordar, reproduzir e corrigir, sem depender da minha autoridade.
        </p>
      </div>

      <ol class="metodo-board">
        <li>
          <span class="cell code">M1</span>
          <div>
            <h3>Encontro o que está disperso</h3>
            <p>Normas, kernel, fabricantes, código e prática raramente fecham a história sozinhos.</p>
          </div>
        </li>
        <li>
          <span class="cell code">M2</span>
          <div>
            <h3>Organizo o modelo mental</h3>
            <p>Da arquitetura ao detalhe e de volta à aplicação. O porquê vem antes do como.</p>
          </div>
        </li>
        <li>
          <span class="cell code">M3</span>
          <div>
            <h3>Torno a explicação executável</h3>
            <p>Diagramas, labs e ferramentas para inspecionar, quebrar e testar.</p>
          </div>
        </li>
        <li>
          <span class="cell code">M4</span>
          <div>
            <h3>Declaro onde termina a certeza</h3>
            <p>Versão, fonte, suposição e limite à vista. Sem DBC, sem inventar sinal.</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="secao-home">
      <div class="secao-cabecalho">
        <h2>Onze trilhas no eixo automotivo</h2>
        <p>
          Publicação em lotes revisáveis. Ferramentas só quando provam um conceito,
          não para encher catálogo.
        </p>
      </div>

      <div class="board-table tracks" role="list">
        {
          trilhas.map((trilha) => (
            <div class="board-entry" role="listitem">
              <span class="cell code">{String(trilha.numero).padStart(2, "0")}</span>
              <span class="cell dest">
                <strong>{trilha.titulo}</strong>
                <em>{trilha.resumo}</em>
              </span>
              <span class={`cell status ${trilha.publicados > 0 ? "on-time" : "hold"}`}>
                {trilha.publicados > 0
                  ? `${trilha.publicados} PUB`
                  : "HOLD"}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="secao-home">
      <div class="secao-cabecalho">
        <h2>Embarque agora</h2>
        <p>Textos e ferramentas publicados. Rascunhos ficam no repositório até a revisão.</p>
      </div>

      <div class="board-table resources" role="list">
        {
          publicados.slice(0, 4).map((artigo) => (
            <a
              class="board-entry"
              href={`/automotivo/${slugDoArtigo(artigo)}/`}
              role="listitem"
            >
              <span class="cell code">
                {rotuloDiataxis(artigo.data.tipoDiataxis).slice(0, 3).toUpperCase()}
              </span>
              <span class="cell dest">
                <strong>{artigo.data.titulo}</strong>
                <em>{artigo.data.resumo}</em>
              </span>
              <span class="cell status on-time">PUB</span>
            </a>
          ))
        }
        <a class="board-entry" href="/ferramentas/quadro-can/" role="listitem">
          <span class="cell code">CAN</span>
          <span class="cell dest">
            <strong>Explorador de quadros CAN</strong>
            <em>Identificador, DLC, prioridade e payload, com limites explícitos.</em>
          </span>
          <span class="cell status on-time">LIVE</span>
        </a>
      </div>
    </section>

    <section class="secao-autor" id="autor">
      <div class="autor-marca" aria-hidden="true">VC</div>
      <div>
        <h2>Victor Caporici</h2>
        <p class="autor-resumo">
          Engenheiro de software sênior C/C++ na TOTVS. Trabalho no núcleo de sistemas
          com décadas de compatibilidade, milhares de integrações e pouco espaço para
          quebrar quem está na ponta.
        </p>
        <p>
          O Caporici Labs nasceu do jeito como eu resolvo produção: reconstruo o
          contexto, marco as fronteiras, testo hipóteses e deixo o caminho legível
          para a próxima pessoa.
        </p>
        <div class="acoes">
          <a class="botao" href="https://github.com/Victor23HD">GitHub</a>
          <a class="botao secundario" href="https://github.com/Victor23HD/Caporici-Labs">Código do projeto</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      const el = document.getElementById("board-clock");
      if (!el) return;
      function tick() {
        const d = new Date();
        el.textContent = d.toLocaleTimeString("pt-BR", {
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        });
      }
      tick();
      setInterval(tick, 15000);
    })();
  </script>
</BaseLayout>
