---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  listarArtigos,
  slugDoArtigo,
  trilhasComContagem,
} from "../lib/content";

const artigos = await listarArtigos();
const publicados = artigos.filter((item) => item.data.status === "publicado");
const trilhas = trilhasComContagem(artigos);
const trilhasAtivas = trilhas.filter((t) => t.publicados > 0).length;

const areas = [
  {
    path: "automotivo",
    titulo: "Automotivo",
    estado: "aberto",
    href: "/automotivo/",
    texto: `${publicados.length} textos publicados · CAN, UDS, AUTOSAR`,
  },
  {
    path: "aviacao",
    titulo: "Aviação",
    estado: "pesquisa",
    texto: "Linha de pesquisa — ainda sem corpus publicado",
  },
  {
    path: "ferroviario",
    titulo: "Ferroviário",
    estado: "pesquisa",
    texto: "Linha de pesquisa — ainda sem corpus publicado",
  },
  {
    path: "agro",
    titulo: "Agro",
    estado: "pesquisa",
    texto: "Linha de pesquisa — ainda sem corpus publicado",
  },
  {
    path: "nautico",
    titulo: "Náutico",
    estado: "pesquisa",
    texto: "Linha de pesquisa — ainda sem corpus publicado",
  },
  {
    path: "fundamentos",
    titulo: "Fundamentos",
    estado: "base",
    texto: "Base transversal entre os eixos",
  },
];
---

<BaseLayout
  title="Caporici Labs: síntese de engenharia embarcada crítica"
  description="Caporici Labs reúne o conhecimento disperso sobre sistemas embarcados críticos e transforma em um corpus com fonte, limite e próximo passo — de desenvolvedor para desenvolvedor."
  active="home"
>
  <main class="home">
    <section class="cyclorama-hero" aria-label="Abertura">
      <div class="cyclorama-field" aria-hidden="true">
        <img
          class="cyclorama-image"
          src="/images/cyclorama-dawn-hero.png"
          alt=""
          width="1536"
          height="1024"
          decoding="async"
          fetchpriority="high"
        />
        <div class="cyclorama-wash"></div>
      </div>

      <div class="wrap hero-stage">
        <h1 class="brand-mega">Caporici Labs</h1>
        <p class="hero-headline">
          Eu sintetizo o que a internet espalha.
        </p>
        <p class="hero-lede">
          Normas, fóruns, PDFs de fabricante e prática de produção viram um
          corpus de engenharia crítica — com fonte, limite e o próximo passo
          à vista.
        </p>
        <div class="acoes">
          <a class="botao" href="#sintese">Ver como sintetizo</a>
          <a class="botao secundario" href="/automotivo/">Entrar no automotivo</a>
        </div>
      </div>
    </section>

    <div class="wrap home-body">
      <section class="secao-home" id="sintese">
        <div class="secao-cabecalho">
          <h2>Do ruído disperso a um modelo que se segura</h2>
          <p>
            O potencial que este site vende não é tipografia de terminal.
            É a capacidade de reunir o confuso, cortar o que não se sustenta
            e entregar um caminho legível.
          </p>
        </div>

        <ol class="sintese-passos">
          <li>
            <strong>Reúno o disperso</strong>
            <p>
              Puxo o que está espalhado: edição de norma, nota de fabricante,
              código de kernel, thread de fórum e o que a linha de produção
              realmente faz.
            </p>
          </li>
          <li>
            <strong>Sintetizo o modelo</strong>
            <p>
              Conecto camadas — do sinal elétrico à nuvem — na ordem em que
              um desenvolvedor precisa pensar, não na ordem em que os PDFs
              foram publicados.
            </p>
          </li>
          <li>
            <strong>Marco o limite</strong>
            <p>
              Separo fato, prática industrial, simplificação didática e
              hipótese. Ferramenta sem DBC não inventa sinal.
            </p>
          </li>
        </ol>
      </section>

      <section class="secao-home" id="camadas">
        <div class="secao-cabecalho">
          <h2>Uma cena, várias camadas</h2>
          <p>
            Os setores mudam de nome; os problemas se repetem. Eu conecto as
            camadas em vez de ensiná-las como ilhas.
          </p>
        </div>

        <ol class="camadas">
          <li><strong>Física</strong><span>Sinal, ruído, terminação</span></li>
          <li><strong>Rede</strong><span>Quadros, arbitragem, erro</span></li>
          <li><strong>Plataforma</strong><span>MCU, RTOS, Linux</span></li>
          <li><strong>Aplicação</strong><span>Controle e diagnóstico</span></li>
          <li><strong>Edge</strong><span>Gateway, OTA, telemetria</span></li>
        </ol>
      </section>

      <section class="secao-home" id="areas">
        <div class="secao-cabecalho">
          <h2>Onde a síntese já existe</h2>
          <p>
            Automotivo é o primeiro eixo aberto. As outras áreas ficam
            marcadas como pesquisa até haver corpus de verdade —
            {trilhasAtivas} eixo ativo, {publicados.length} textos publicados.
          </p>
        </div>

        <div class="area-lista" role="list">
          {
            areas.map((area) =>
              area.href ? (
                <a class="area-linha" href={area.href} role="listitem">
                  <span class={`estado-pill ${area.estado}`}>{area.estado}</span>
                  <span class="area-titulo">{area.titulo}</span>
                  <span class="area-texto">{area.texto}</span>
                </a>
              ) : (
                <div class="area-linha dim" role="listitem">
                  <span class={`estado-pill ${area.estado}`}>{area.estado}</span>
                  <span class="area-titulo">{area.titulo}</span>
                  <span class="area-texto">{area.texto}</span>
                </div>
              ),
            )
          }
        </div>
      </section>

      <section class="secao-home" id="publicado">
        <div class="secao-cabecalho">
          <h2>Já dá para ler e usar</h2>
          <p>Textos e ferramentas revisados. O restante fica no repositório.</p>
        </div>

        <div class="pub-lista" role="list">
          {
            publicados.slice(0, 4).map((artigo) => (
              <a
                class="pub-linha"
                href={`/automotivo/${slugDoArtigo(artigo)}/`}
                role="listitem"
              >
                <span class="pub-ordem">
                  {String(artigo.data.ordem).padStart(2, "0")}
                </span>
                <span class="pub-corpo">
                  <strong>{artigo.data.titulo}</strong>
                  <em>{artigo.data.resumo}</em>
                </span>
              </a>
            ))
          }
          <a class="pub-linha" href="/ferramentas/quadro-can/" role="listitem">
            <span class="pub-ordem">CAN</span>
            <span class="pub-corpo">
              <strong>Explorador de quadros CAN</strong>
              <em>Identificador, DLC e prioridade — sem inventar DBC.</em>
            </span>
          </a>
        </div>
      </section>

      <section class="secao-autor" id="autor">
        <div class="autor-marca" aria-hidden="true">VC</div>
        <div>
          <h2>Victor Caporici</h2>
          <p class="autor-resumo">
            Engenheiro de software sênior C/C++ na TOTVS. Trabalho em sistemas
            com décadas de compatibilidade e pouco espaço para quebrar quem
            está na ponta. Este laboratório é onde eu publico a síntese que
            faço ao pesquisar.
          </p>
          <div class="acoes">
            <a class="botao secundario" href="https://github.com/Victor23HD">GitHub</a>
            <a class="botao secundario" href="https://github.com/Victor23HD/Caporici-Labs">
              Código do projeto
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
