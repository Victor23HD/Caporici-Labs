---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  listarArtigos,
  slugDoArtigo,
  trilhasComContagem,
} from "../lib/content";

const artigos = await listarArtigos();
const publicados = artigos.filter((item) => item.data.status === "publicado");
const trilhas = trilhasComContagem(artigos);
const trilhasAtivas = trilhas.filter((t) => t.publicados > 0).length;

const areas = [
  {
    path: "automotivo/",
    titulo: "Automotivo",
    flag: "ok",
    href: "/automotivo/",
    texto: `${publicados.length} textos · CAN, UDS, AUTOSAR`,
  },
  {
    path: "aviacao/",
    titulo: "Aviação",
    flag: "wait",
    texto: "Linha de pesquisa",
  },
  {
    path: "ferroviario/",
    titulo: "Ferroviário",
    flag: "wait",
    texto: "Linha de pesquisa",
  },
  {
    path: "agro/",
    titulo: "Agro",
    flag: "wait",
    texto: "Linha de pesquisa",
  },
  {
    path: "nautico/",
    titulo: "Náutico",
    flag: "wait",
    texto: "Linha de pesquisa",
  },
  {
    path: "core/",
    titulo: "Fundamentos",
    flag: "base",
    texto: "Base transversal",
  },
];
---

<BaseLayout
  title="Caporici Labs: engenharia de sistemas embarcados, explicada de dev para dev"
  description="Caporici Labs organiza, conecta e verifica conhecimento sobre sistemas embarcados críticos: automotivo, aviação, ferroviário, agrícola e náutico, de desenvolvedor para desenvolvedor."
  active="home"
>
  <main class="home">
    <section class="term-hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 class="brand-mega">
            Caporici<br />Labs<span class="cursor" aria-hidden="true"></span>
          </h1>
          <p class="term-lede">
            Engenharia embarcada crítica, do sinal elétrico à nuvem, com fonte,
            limite e ferramenta à vista.
          </p>
          <div class="acoes">
            <a class="botao" href="#areas">Ver áreas</a>
            <a class="botao secundario" href="/automotivo/">Abrir automotivo</a>
          </div>
        </div>

        <aside class="hero-panel" aria-label="Status das áreas">
          <div class="hero-panel-bar">
            <span>áreas</span>
            <span>{trilhasAtivas} ativa{trilhasAtivas === 1 ? "" : "s"} · {publicados.length} textos</span>
          </div>
          <div class="term-list compact" role="list">
            {
              areas.map((area) =>
                area.href ? (
                  <a class="term-row" href={area.href} role="listitem">
                    <span class={`flag ${area.flag}`}>{area.flag}</span>
                    <span class="path">{area.path}</span>
                    <span class="meta">
                      <strong>{area.titulo}</strong>
                      <em>{area.texto}</em>
                    </span>
                  </a>
                ) : (
                  <div class="term-row dim" role="listitem">
                    <span class={`flag ${area.flag}`}>{area.flag}</span>
                    <span class="path">{area.path}</span>
                    <span class="meta">
                      <strong>{area.titulo}</strong>
                      <em>{area.texto}</em>
                    </span>
                  </div>
                ),
              )
            }
          </div>
        </aside>
      </div>
    </section>

    <div class="wrap home-body">
      <section class="secao-home" id="areas">
        <div class="secao-cabecalho">
          <h2>Do fio à nuvem</h2>
          <p>
            Os setores mudam de nome; os problemas se repetem. Eu conecto as camadas
            em vez de ensiná-las como ilhas.
          </p>
        </div>

        <ol class="camadas">
          <li><strong>Física</strong><span>Sinal, ruído, terminação</span></li>
          <li><strong>Rede</strong><span>Quadros, arbitragem, erro</span></li>
          <li><strong>Plataforma</strong><span>MCU, RTOS, Linux</span></li>
          <li><strong>Aplicação</strong><span>Controle e diagnóstico</span></li>
          <li><strong>Edge</strong><span>Gateway, OTA, telemetria</span></li>
        </ol>
      </section>

      <section class="secao-home" id="metodo">
        <div class="secao-cabecalho">
          <h2>Como eu trabalho</h2>
          <p>
            Confiança vem de separar fato, interpretação e hipótese, não de layout
            bonito.
          </p>
        </div>

        <ol class="metodo-limpo">
          <li>
            <strong>Encontro o disperso</strong>
            <p>Normas, kernel, fabricantes e prática.</p>
          </li>
          <li>
            <strong>Organizo o modelo</strong>
            <p>Arquitetura → detalhe → aplicação.</p>
          </li>
          <li>
            <strong>Marco o limite</strong>
            <p>Fonte, versão e o que a ferramenta não faz.</p>
          </li>
        </ol>
      </section>

      <section class="secao-home" id="publicado">
        <div class="secao-cabecalho">
          <h2>Publicado</h2>
          <p>Textos e ferramentas revisados. O restante fica no repositório.</p>
        </div>

        <div class="term-list" role="list">
          {
            publicados.slice(0, 4).map((artigo) => (
              <a
                class="term-row"
                href={`/automotivo/${slugDoArtigo(artigo)}/`}
                role="listitem"
              >
                <span class="flag ok">ok</span>
                <span class="path">
                  {String(artigo.data.ordem).padStart(2, "0")}
                </span>
                <span class="meta">
                  <strong>{artigo.data.titulo}</strong>
                  <em>{artigo.data.resumo}</em>
                </span>
              </a>
            ))
          }
          <a class="term-row" href="/ferramentas/quadro-can/" role="listitem">
            <span class="flag live">live</span>
            <span class="path">can</span>
            <span class="meta">
              <strong>Explorador de quadros CAN</strong>
              <em>Identificador, DLC e prioridade, sem inventar DBC.</em>
            </span>
          </a>
        </div>
      </section>

      <section class="secao-autor" id="autor">
        <div class="autor-marca" aria-hidden="true">VC</div>
        <div>
          <h2>Victor Caporici</h2>
          <p class="autor-resumo">
            Engenheiro de software sênior C/C++ na TOTVS. Trabalho em sistemas com
            décadas de compatibilidade e pouco espaço para quebrar quem está na ponta.
          </p>
          <div class="acoes">
            <a class="botao secundario" href="https://github.com/Victor23HD">GitHub</a>
            <a class="botao secundario" href="https://github.com/Victor23HD/Caporici-Labs">
              Código do projeto
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
